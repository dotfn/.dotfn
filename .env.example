# Ruta a tu carpeta de proyectos en el host (relativa o absoluta)
# Por defecto usa el directorio padre de este proyecto
PROJECTS_PATH=./

# Tu nombre y email para git (si no querés montar ~/.gitconfig)
# GIT_USER_NAME="Tu Nombre"
# GIT_USER_EMAIL="tu@email.com"

# API keys que quieras tener disponibles en el contenedor
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
